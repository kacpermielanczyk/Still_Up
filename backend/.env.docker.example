# Docker Compose runtime configuration.
APP_NAME=StillUp API
APP_ENV=docker
DEBUG=false
VERSION=0.1.0

API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:8080

# FastAPI / worker database connection.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stillup
DB_USER=stillup
DB_PASSWORD=replace-with-a-strong-database-password

# PostgreSQL container bootstrap values.
# Keep them in sync with DB_NAME / DB_USER / DB_PASSWORD above.
POSTGRES_DB=stillup
POSTGRES_USER=stillup
POSTGRES_PASSWORD=replace-with-a-strong-database-password

AUTO_MIGRATE=true

WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=10

JWT_SECRET=replace-with-a-long-random-docker-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
